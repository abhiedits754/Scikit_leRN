##    found the outlier and fraud cases through the outlier by isolation forest

import numpy as n 
import pandas as p 
import matplotlib.pyplot as m
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import GridSearchCV
from sklearn.metrics import precision_score, recall_score, make_scorer
from sklearn.preprocessing import OneHotEncoder
from sklearn.ensemble import IsolationForest

dst = p.read_csv("housing.csv")[:80000]

# Separate features and target
X = dst.drop(columns=['median_income','total_bedrooms','latitude'])
y = (dst['latitude'] > 35).astype(int).values   # binary target

# One-hot encode categorical features (like ocean_proximity)
# X = pd.get_dummies(X).values

mod = IsolationForest().fit(X)
mod.predict(X)
print(mod)
def outlier_precision(estimator, X, y):        
    preds = estimator.predict(X)
    preds = n.where(preds == -1, 1, 0) 
    return precision_score(y, preds, zero_division=0)
def outlier_recall(estimator, X, y):
    preds = estimator.predict(X)
    preds = n.where(preds == -1, 1, 0) 
    return recall_score(y, preds, zero_division=0) 

grid = GridSearchCV(
    estimator=IsolationForest(random_state=42),
    param_grid={
        'contamination':n.linspace(0.001,0.02,10)
        },
    scoring={
        'precision':outlier_precision,
             'recall':outlier_recall}  ,
    refit='precision',         
    cv=5  ,
    n_jobs=-1
)
grid.fit(X, y)



# da = pd.DataFrame(grid.cv_results_)

