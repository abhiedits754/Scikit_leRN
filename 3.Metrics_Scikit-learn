m.figure(figsize=(12,4))
df_results = p.DataFrame(grid.cv_results_)
for score in ['mean_test_recall','mean_test_precision']:
    m.plot(df_results['param_contamination'],
    df_results[score],
    label=score)
m.legend()
m.show()
print(grid.best_params_)
print(grid.best_score_)


