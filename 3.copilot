import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import GridSearchCV
from sklearn.metrics import precision_score, recall_score, make_scorer
from sklearn.preprocessing import OneHotEncoder

dst = pd.read_csv("housing.csv")[:80000]

# Separate features and target
X = dst.drop(columns=['median_income','total_bedrooms','latitude'])
y = (dst['latitude'] > 35).astype(int).values   # binary target

# One-hot encode categorical features (like ocean_proximity)
X = pd.get_dummies(X).values

def min_recall_precision(y_true, y_pred):
    recall = recall_score(y_true, y_pred)
    precision = precision_score(y_true, y_pred)
    return min(recall, precision)

grid = GridSearchCV(
    estimator=LogisticRegression(max_iter=1000),
    param_grid={'class_weight': [{0:1, 1:v} for v in np.linspace(1, 20, 30)]},
    scoring={
        'precision': make_scorer(precision_score),
        'recall': make_scorer(recall_score),
        'min_both': make_scorer(min_recall_precision)
    },
    refit='min_both',
    return_train_score=True,
    cv=4,
    n_jobs=-1
)

grid.fit(X, y)

da = pd.DataFrame(grid.cv_results_)

plt.figure(figsize=(6,8))
for score in ['mean_test_precision','mean_test_recall','mean_test_min_both']:
    plt.plot([cw[1] for cw in da['param_class_weight']], da[score], label=score)

plt.xlabel("Class weight for class 1")
plt.ylabel("Score")
plt.legend()
plt.show()


